{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "FoodBridge.Infrastructure.Auth.MockSmsProvider": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=tcp:foodbridge-sql.database.windows.net,1433;Initial Catalog=FoodBridgeDb;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;Authentication=\"Active Directory Default\""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [ "https://REPLACE-ME-foodbridge-web.azurewebsites.net" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/foodbridge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
