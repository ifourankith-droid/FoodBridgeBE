<?xml version="1.0" encoding="utf-8"?>
<!--
  Present purely to turn on ASP.NET Core Module stdout logging, which is what makes an HTTP 500.30
  ("ASP.NET Core app failed to start") diagnosable on Windows App Service.

  Without it, a crash *before* the web host is built produces no HTTP response body, nothing in the
  Log Stream, and nothing in LogFiles/Application — the failure is genuinely invisible. With it, the
  full exception lands in \home\LogFiles\stdout_*.log (Kudu → Debug console → LogFiles).

  The publish process rewrites `processPath` and `arguments` for the real assembly, so the
  placeholders below are intentional — do not hand-edit them.

  stdoutLogEnabled is left ON deliberately: these logs are small, the directory is already
  ephemeral, and being able to read a startup failure immediately is worth more than the disk.
  hostingModel="inprocess" matches the SDK default for ASP.NET Core on IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!--
            The app targets net6.0, which is out of support and no longer present on current App
            Service runtime stacks. Rolling forward lets it run on the newest installed major
            (.NET 8+) instead of failing at startup with
            "Framework: 'Microsoft.NETCore.App', version '6.0.0' not found" — the same reason the
            local `npm run backend` script sets this variable.
          -->
          <environmentVariable name="DOTNET_ROLL_FORWARD" value="Major" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
